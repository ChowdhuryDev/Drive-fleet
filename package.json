{
  "name": "drivefleet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"tsx server/src/server.ts\" \"next dev client -p 3000\"",
    "build": "next build client",
    "start": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"tsx server/src/server.ts\" \"next start client -p 3000\"",
    "lint": "tsc --noEmit",
    "dev:client": "next dev client -p 3000",
    "dev:server": "tsx server/src/server.ts",
    "build:client": "next build client",
    "build:server": "tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "axios": "^1.8.1",
    "better-auth": "^1.2.9",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mongodb": "^6.13.0",
    "mongoose": "^8.10.1",
    "motion": "^12.4.7",
    "next": "^15.2.1",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3"
  }
}
